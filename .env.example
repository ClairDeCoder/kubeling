# ── Stat decay ────────────────────────────────────────────────────────────────
# How often (seconds) the decay tick runs per Kubeling
# PROD: 120  |  TESTING (fast death): 5
DECAY_INTERVAL_SECONDS=5

# How much Fullness drops per tick  (0–100 scale)
# PROD: 3  |  TESTING: 34  (hits zero in ~3 ticks)
FULLNESS_DECAY_AMOUNT=3

# How much Mood drops per tick
# PROD: 3  |  TESTING: 34
MOOD_DECAY_AMOUNT=3

# ── Interactions ───────────────────────────────────────────────────────────────
FEED_FULLNESS_BOOST=30
PET_MOOD_BOOST=30

# Starting values for both stats (0–100)
STAT_START_VALUE=100

# ── Sleep cycle ────────────────────────────────────────────────────────────────
# Seconds between sleep cycles (random pick in this range)
# PROD: 300–600  |  TESTING: 30–60
SLEEP_INTERVAL_MIN_SECONDS=300
SLEEP_INTERVAL_MAX_SECONDS=600

# How long a sleep lasts (seconds)
SLEEP_DURATION_MIN_SECONDS=30
SLEEP_DURATION_MAX_SECONDS=90

# Stat decay multiplier while sleeping (0 = paused, 0.5 = half speed)
SLEEP_DECAY_MULTIPLIER=0.25

# ── Capacity ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_KUBELINGS=100

# ── WebSocket ──────────────────────────────────────────────────────────────────
# How often the server sends a heartbeat ping to the client (seconds)
HEARTBEAT_INTERVAL_SECONDS=15

# ── DynamoDB ───────────────────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=kubelings
AWS_REGION=us-east-1

# Local DynamoDB override (leave blank in prod)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
